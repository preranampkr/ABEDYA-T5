# Client-side Supabase configuration (safe to expose in browser bundle via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-side Supabase credentials for Vercel Serverless Functions (/api/*)
# NEVER prefix service-role keys with VITE_ — keep them server-only in Vercel Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
